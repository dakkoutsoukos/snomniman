# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Packaging build/installer outputs (packaging/snomniman.spec + .iss + the
# entry point/icon/version-info scripts ARE committed; only build artifacts
# aren't). packaging/build/ and packaging/dist/ already match the patterns
# above; installer_dist/ needs its own entry since it isn't named "dist".
packaging/installer_dist/

# Environments
.venv/
venv/
.env

# uv: the lockfile IS committed for reproducibility - do not ignore uv.lock

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.obsidian/
*.swp
.DS_Store
Thumbs.db

# Scientific data must never be committed to the source repo.
# Raw files are referenced by path + hash, not stored here (see data-model.md).
# The real neaSNOM sample measurements (~192 MB) live here locally; the golden
# tests skip cleanly when this folder is absent (e.g. on CI / a fresh clone).
/data/
/scratch/
/SNOM Sample Files/
*.gsf
*.nea
*.h5
*.hdf5
*.nc

# Real lab measurement data and screenshots: never published.
/SNOM Sample Files/
